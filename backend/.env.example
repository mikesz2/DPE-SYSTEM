# Este arquivo é copiado automaticamente para ".env" na primeira vez que você
# roda o launcher (INICIAR.bat / iniciar.sh) — não precisa copiar manualmente.
# Depois de criado, edite o .env (não este arquivo) se quiser mudar algo.

# SQLite: um único arquivo local, sem precisar instalar banco separado.
DATABASE_URL="file:./data/system-dpe.db"

# Gerado automaticamente pelo launcher na primeira execução.
JWT_SECRET="sera-substituido-automaticamente"
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=production

# Domínio do hotel Habbo usado para consultar a API pública e o avatar imaging.
HABBO_DOMAIN="habbo.com.br"

# IMPORTANTE: coloque o nick EXATO da sua conta Habbo aqui antes do primeiro
# cadastro — essa conta nasce como administrador do System automaticamente.
HABBO_BOOTSTRAP_ADMIN="SeuNickHabbo"

# Em produção é obrigatório usar a origem exata. Para desenvolvimento local,
# use a URL em que o frontend é servido.
CORS_ORIGIN="http://localhost:4000"

# Faixas adicionais do proxy interno da Discloud, se ela fornecer endereços
# públicos dedicados. Loopback e redes privadas já são reconhecidos internamente.
DISCLOUD_PROXY_CIDRS=""

# Retenção dos metadados de segurança (sem corpos, senhas, cookies ou tokens).
SECURITY_LOG_RETENTION_DAYS=90
SECURITY_LOG_MAX_EVENTS=50000

# Token compartilhado com o DPE Command para iniciar e encerrar turnos.
# Gere um valor aleatório longo e configure o mesmo token nos dois sistemas.
DPE_COMMAND_API_TOKEN="troque-por-um-token-seguro-com-pelo-menos-32-caracteres"

# Quantos snapshots automáticos pré-migração manter em data/backups/.
# Permitido: 3 a 60. Padrão: 14.
DATABASE_BACKUP_KEEP=14
